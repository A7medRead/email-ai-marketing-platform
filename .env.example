# Required application secrets: generate unique random values for each deployment.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ENCRYPTION_KEY=

# Public URL used in campaign tracking and password recovery links.
TRACKING_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:5173

# Optional SMTP settings required for password recovery emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
