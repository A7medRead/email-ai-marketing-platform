.profile-page{
    padding:30px;
    color:white;
}


/* Header */

.profile-title{
    margin-bottom:25px;
}

.profile-title h1{
    font-size:32px;
    margin:0;
}

.profile-breadcrumb{
    color:#94a3b8;
    margin-top:8px;
}


/* Hero */

.profile-hero{
    background:linear-gradient(120deg,#15132b,#0f172a);
    border:1px solid #25204a;
    border-radius:22px;
    padding:35px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    position:relative;
    overflow:hidden;
}


.profile-hero:after{
    content:"✉";
    position:absolute;
    right:80px;
    top:40px;
    font-size:120px;
    opacity:.12;
    color:#8b5cf6;
}


.profile-main{
    display:flex;
    align-items:center;
    gap:25px;
    position:relative;
}


.profile-avatar{
    width:150px;
    height:150px;
    border-radius:50%;
    object-fit:cover;
    border:4px solid #7c3aed;
    box-shadow:0 0 0 4px #7c3aed;
}


.profile-name{
    font-size:36px;
    margin:0;
}


.profile-email{
    color:#94a3b8;
}


.profile-badge{
    display:inline-block;
    background:#6d28d9;
    padding:6px 15px;
    border-radius:20px;
    margin:10px 0;
}


/* Button */

.profile-btn{
    background:#7c3aed;
    color:white;
    border:none;
    padding:12px 25px;
    border-radius:10px;
    cursor:pointer;
    display:flex;
    align-items:center;
    gap:8px;
}


/* Info cards */

.profile-stats{
    display:grid;
    grid-template-columns:repeat(5,1fr);
    gap:15px;
    margin-top:25px;
}


.profile-box,
.profile-panel{
    background:#111827;
    border:1px solid #1f2937;
    border-radius:18px;
    padding:22px;
}


.profile-box h4{
    color:#94a3b8;
    margin:0 0 10px;
}


/* Bottom */

.profile-bottom{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:20px;
    margin-top:25px;
}


.profile-panel h3{
    margin-top:0;
}


.profile-panel p{
    color:#94a3b8;
}


.profile-panel strong{
    display:block;
    margin-bottom:15px;
}


.activity{
    padding:15px;
    border-bottom:1px solid #1f2937;
}


/* Avatar edit */

.avatar-edit{
    position:absolute;
    left:120px;
    top:110px;
    width:35px;
    height:35px;
    background:#7c3aed;
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    cursor:pointer;
    border:3px solid #111827;
}


.avatar-edit input{
    display:none;
}


/* Modal */

.profile-modal-bg{
    position:fixed;
    inset:0;
    background:rgba(0,0,0,.65);
    display:flex;
    align-items:center;
    justify-content:center;
    z-index:2000;
}


.profile-modal{
    width:480px;
    background:#111827;
    padding:35px;
    border-radius:24px;
    border:1px solid #4c1d95;
    box-shadow:0 20px 50px rgba(0,0,0,.5);
}


.modal-header h2{
    color:white;
    margin-bottom:25px;
}


.profile-modal label{
    display:block;
    color:#94a3b8;
    margin:12px 0 6px;
    font-size:14px;
}


.edit-input{
    width:100%;
    box-sizing:border-box;
    background:#0f172a;
    color:white;
    border:1px solid #334155;
    padding:12px;
    border-radius:12px;
}


.edit-input:focus{
    outline:none;
    border-color:#8b5cf6;
}


.modal-actions{
    display:flex;
    gap:12px;
    margin-top:25px;
}


.modal-btn{
    flex:1;
    padding:12px;
    border-radius:10px;
    border:none;
    cursor:pointer;
}


.save-btn{
    background:#7c3aed;
    color:white;
}


.cancel-btn{
    background:#1f2937;
    color:white;
}


/* final polish */

.profile-hero{
    min-height:170px;
    padding:35px 45px;
}


.profile-main{
    gap:35px;
}


.profile-avatar{
    width:160px;
    height:160px;
}


